# ---------------------------------------------------------------
# Outreach Bot - configuración
# Copia este archivo a .env y completa lo que vayas a usar.
# Cada etapa puede ir en "mock" (simulada) o con el proveedor real.
# ---------------------------------------------------------------

# URL pública (ngrok) para que Vapi y SignalHire envíen webhooks
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# Secreto compartido para validar webhooks entrantes (pon algo largo y aleatorio)
WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo

TIMEZONE=America/Bogota

# --- Selección de proveedores: mock | real -----------------------
LINKEDIN_PROVIDER=mock        # mock | serpapi
ENRICHMENT_PROVIDER=mock      # mock | signalhire | cascada: signalhire,mock
VOICE_PROVIDER=mock           # mock | vapi
CALENDAR_PROVIDER=mock        # mock | google

# --- 1. Identificación LinkedIn (SerpAPI, búsqueda site:linkedin.com/in) ---
SERPAPI_API_KEY=
LINKEDIN_MIN_CONFIDENCE=0.6

# --- 2. Enriquecimiento (SignalHire) ---------------------------------------
SIGNALHIRE_API_KEY=
ENRICHMENT_TIMEOUT_S=90

# --- 3. Llamada (Vapi) -----------------------------------------------------
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_ID=es-CO-SalomeNeural
VAPI_VOICE_MODEL=
# Voz del agente HOMBRE (vacío = misma voz). Con 11labs debe estar en "My Voices" de tu cuenta.
VAPI_VOICE_ID_MALE=
# nova-3 + multilingüe = español, inglés y portugués en la misma llamada
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_MULTILINGUAL=true
CALL_TIMEOUT_S=600

# --- 4. Agenda + correo (Google Calendar / Gmail) --------------------------
GOOGLE_CREDENTIALS_FILE=secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
GOOGLE_CALENDAR_ID=primary
MEETING_DURATION_MIN=15
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
BOOKING_URL=

# --- Personalización del guion ----------------------------------------------
AGENT_NAME=Sofía
AGENT_NAME_MALE=Daniel
# opposite: a un hombre lo llama Sofía y a una mujer Daniel | female | male
AGENT_GENDER_MODE=opposite
# idioma de apertura si la base no trae la columna "idioma": es | en | pt
DEFAULT_LANGUAGE=es
COMPANY_NAME=Empresa X
BRAND_NAME=Lenovo
EVENT_NAME=ANDICOM 2026
SENDER_TITLE=Ejecutiva de cuenta
SENDER_TITLE_MALE=Ejecutivo de cuenta
# firma del correo de seguimiento (como en el Word): [Teléfono] · [Correo]
SENDER_PHONE=
SENDER_EMAIL=

# --- Cumplimiento -----------------------------------------------------------
# En sandbox SOLO se llama a números con consentimiento (columna telefono_consentido
# del CSV o lista blanca). Ponlo en false solo con una base con consentimiento real.
SANDBOX_MODE=true
ALLOWED_PHONE_NUMBERS=+573001234567
